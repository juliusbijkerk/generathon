# Copy this to .env and fill in real values. Never commit .env.
# See docs/SETUP.md for exactly where to get each of these.

# --- Supabase (dashboard: Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vite reads these, must be prefixed VITE_) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- LLM providers (you said you already have all of these) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- Model selection (env-driven so swapping is a config change, not a code change) ---
# Fast/cheap model used for the ONE live, on-stage classification call (latency matters).
CLASSIFY_MODEL_LIVE=gpt-4o-mini
# Higher-quality model used for pre-baked nightly ranking support and script writing (latency does not matter).
CLASSIFY_MODEL_BATCH=claude-sonnet-4-6
SCRIPT_MODEL=claude-sonnet-4-6

# --- TTS ---
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx

# --- Telegram bot (BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Email (resend.com) ---
RESEND_API_KEY=
RESEND_FROM="FOC <brief@yourdomain.dev>"
RESEND_TO=you@example.com
