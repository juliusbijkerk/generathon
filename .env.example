# Copy this to .env and fill in real values. Never commit .env.
# See docs/SETUP.md for exactly where to get each of these.

# --- Supabase (dashboard: Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vite reads these, must be prefixed VITE_) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- LLM providers ---
# OpenAI-only setup by default (classification + script writing both run on
# OpenAI models) - set ANTHROPIC_API_KEY too if you'd rather use Claude for
# script writing (SCRIPT_MODEL=claude-sonnet-4-6), but it's optional.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- Model selection (env-driven so swapping is a config change, not a code change) ---
# Fast/cheap model used for the ONE live, on-stage classification call (latency matters).
CLASSIFY_MODEL_LIVE=gpt-4o-mini
# Higher-quality model for the two-host video script. gpt-4o by default (OpenAI-only setup);
# set to a claude-* model instead if ANTHROPIC_API_KEY is set.
SCRIPT_MODEL=gpt-4o

# --- TTS (two voices so the script's two-host banter sounds like two people) ---
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_A=onyx
OPENAI_TTS_VOICE_B=shimmer

# --- Telegram bot (BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Email (resend.com) ---
RESEND_API_KEY=
RESEND_FROM="FOC <brief@yourdomain.dev>"
RESEND_TO=you@example.com
